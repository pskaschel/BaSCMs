@article{chakraborty2003,
	title = {Estimating correlation by using a general linear mixed model: evaluation of the relationship between the concentration of {HIV}‐1 {RNA} in blood and semen},
	volume = {22},
	issn = {0277-6715, 1097-0258},
	shorttitle = {Estimating correlation by using a general linear mixed model},
