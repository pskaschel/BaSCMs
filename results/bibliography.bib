	file = {rappel-et-al-2025-basic-psychological-needs-are-associated-with-engagement-and-hate-term-use-in-extremist-chatrooms:C\:\\Users\\pskas\\Zotero\\storage\\IPKLIMJ5\\rappel-et-al-2025-basic-psychological-needs-are-associated-with-engagement-and-hate-term-use-in-extremist-chatrooms.pdf:application/pdf},
