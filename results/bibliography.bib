	pages = {1105},
	file = {Kaptein and Robertson - 2012 - Rethinking statistical analysis methods for CHI:C\:\\Users\\pskas\\Zotero\\storage\\EMV7PUPV\\Kaptein and Robertson - 2012 - Rethinking statistical analysis methods for CHI.pdf:application/pdf;Kaptein and Robertson - 2012 - Rethinking statistical analysis methods for CHI.pdf:C\:\\Users\\pskas\\Zotero\\storage\\39G88ET9\\Kaptein and Robertson - 2012 - Rethinking statistical analysis methods for CHI.pdf:application/pdf},
