	month = mar,
	year = {2015},
	keywords = {attractiveness, static-dynamic\_temporary, movement, dance, gait},
	pages = {1--6},
	file = {Full Text:C\:\\Users\\pskas\\Zotero\\storage\\977SN6UG\\Fink et al. - 2015 - Integrating body movement into attractiveness rese.pdf:application/pdf},
