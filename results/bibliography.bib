@article{hartmann,
	title = {The dissolution of {Germanic} unity - towards a new computational model},
	abstract = {The tripartite tree model has been the status quo of research into Germanic cladistics for more than 50 years. It most famously divides the Germanic clade into East, North and West Germanic while North and West Germanic are more closely related to each other via a common ancestor Proto-Northwest Germanic. However, most scholars are not satisﬁed with the evolutionary model a tree provides for the Germanic language family. It does not suﬃce to model the various interdependencies and break up processes correctly in a two-dimensional tree. Moreover, some languages and split processes seem to elude the tree classiﬁcation entirely (cf. Vandalic’s position in the tree). This problem calls for a further investigation into alternative models and recent phylogenetic and network modelling appear to be the best approaches in the pursuit of a better understanding of the evolution of Germanic language family.},
	language = {en},
