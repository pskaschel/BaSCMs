@article{risko2012,
	title = {Social attention with real versus reel stimuli: toward an empirical approach to concerns about ecological validity},
	volume = {6},
	issn = {1662-5161},
	shorttitle = {Social attention with real versus reel stimuli},
	url = {http://journal.frontiersin.org/article/10.3389/fnhum.2012.00143/abstract},
	doi = {10.3389/fnhum.2012.00143},
	abstract = {Cognitive neuroscientists often study social cognition by using simple but socially relevant stimuli, such as schematic faces or images of other people. Whilst this research is valuable, important aspects of genuine social encounters are absent from these studies, a fact that has recently drawn criticism. In the present review we argue for an empirical approach to the determination of the equivalence of different social stimuli. This approach involves the systematic comparison of different types of social stimuli ranging in their approximation to a real social interaction. In garnering support for this cognitive ethological approach, we focus on recent research in social attention that has involved stimuli ranging from simple schematic faces to real social interactions. We highlight both meaningful similarities and differences in various social attentional phenomena across these different types of social stimuli thus validating the utility of the research initiative. Furthermore, we argue that exploring these similarities and differences will provide new insights into social cognition and social neuroscience.},
	language = {en},
	urldate = {2021-01-28},
	journal = {Frontiers in Human Neuroscience},
	author = {Risko, Evan F. and Laidlaw, Kaitlin and Freeth, Megan and Foulsham, Tom and Kingstone, Alan},
