	file = {Haines et al. - 2020 - Theoretically Informed Generative Models Can Advan.pdf:C\:\\Users\\pskas\\Zotero\\storage\\VEPEQC4V\\Haines et al. - 2020 - Theoretically Informed Generative Models Can Advan.pdf:application/pdf},
