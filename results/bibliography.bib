	file = {2d-3d:C\:\\Users\\pskas\\Zotero\\storage\\DMPWUSGH\\2d-3d.pdf:application/pdf;Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:C\:\\Users\\pskas\\Zotero\\storage\\AW9R7UAN\\Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:application/pdf;Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:C\:\\Users\\pskas\\Zotero\\storage\\RZ74XVKN\\Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:application/pdf;Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:C\:\\Users\\pskas\\Zotero\\storage\\EFGVKIVF\\Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:application/pdf;Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:C\:\\Users\\pskas\\Zotero\\storage\\2SXZZX2P\\Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:application/pdf;Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:C\:\\Users\\pskas\\Zotero\\storage\\UYAH5C8E\\Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:application/pdf;Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:C\:\\Users\\pskas\\Zotero\\storage\\MEAGL6VQ\\Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:application/pdf;Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:C\:\\Users\\pskas\\Zotero\\storage\\M24ZB2DR\\Tigue et al. - 2012 - Men's judgments of women's facial attractiveness f.pdf:application/pdf},
