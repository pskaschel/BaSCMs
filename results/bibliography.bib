	file = {Blanca et al. - 2018 - Current Practices in Data Analysis Procedures in P.pdf:C\:\\Users\\pskas\\Zotero\\storage\\5YCPGB2T\\Blanca et al. - 2018 - Current Practices in Data Analysis Procedures in P.pdf:application/pdf},
}

