	pages = {163--75},
	file = {2013_static_dynamic:C\:\\Users\\pskas\\Zotero\\storage\\TF4K92M2\\2013_static_dynamic.pdf:application/pdf;Kościński - 2013 - Perception of Facial Attractiveness from Static an.pdf:C\:\\Users\\pskas\\Zotero\\storage\\EIXPMZY5\\Kościński - 2013 - Perception of Facial Attractiveness from Static an.pdf:application/pdf;Kościński - 2013 - Perception of Facial Attractiveness from Static an.pdf:C\:\\Users\\pskas\\Zotero\\storage\\XIG9XPFC\\Kościński - 2013 - Perception of Facial Attractiveness from Static an.pdf:application/pdf;Kościński - 2013 - Perception of Facial Attractiveness from Static an.pdf:C\:\\Users\\pskas\\Zotero\\storage\\VB62LIUW\\Kościński - 2013 - Perception of Facial Attractiveness from Static an.pdf:application/pdf;Snapshot:C\:\\Users\\pskas\\Zotero\\storage\\249AGVWH\\p7378.html:text/html;Submitted Version:C\:\\Users\\pskas\\Zotero\\storage\\E58E7SR9\\Kościński - 2013 - Perception of facial attractiveness from static an.pdf:application/pdf},
