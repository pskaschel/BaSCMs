	pages = {4191--4195},
	file = {Kalayci et al. - 2014 - Automatic analysis of facial attractiveness from v.pdf:C\:\\Users\\pskas\\Zotero\\storage\\MM5MPUK4\\Kalayci et al. - 2014 - Automatic analysis of facial attractiveness from v.pdf:application/pdf},
}

