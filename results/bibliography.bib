@article{albers2018,
	title = {When power analyses based on pilot data are biased: {Inaccurate} effect size estimators and follow-up bias},
	volume = {74},
	issn = {00221031},
	shorttitle = {When power analyses based on pilot data are biased},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S002210311630230X},
	doi = {10/gcsz36},
	abstract = {When designing a study, the planned sample size is often based on power analyses. One way to choose an eﬀect size for power analyses is by relying on pilot data. A-priori power analyses are only accurate when the eﬀect size estimate is accurate. In this paper we highlight two sources of bias when performing a-priori power analyses for between-subject designs based on pilot data. First, we examine how the choice of the eﬀect size index (η2, ω2 and ε2) aﬀects the sample size and power of the main study. Based on our observations, we recommend against the use of η2 in a-priori power analyses. Second, we examine how the maximum sample size researchers are willing to collect in a main study (e.g. due to time or ﬁnancial constraints) leads to overestimated eﬀect size estimates in the studies that are performed. Determining the required sample size exclusively based on the eﬀect size estimates from pilot data, and following up on pilot studies only when the sample size estimate for the main study is considered feasible, creates what we term follow-up bias. We explain how follow-up bias leads to underpowered main studies.},
	language = {en},
	urldate = {2024-03-21},
	journal = {Journal of Experimental Social Psychology},
	author = {Albers, Casper and Lakens, Daniël},
	month = jan,
	year = {2018},
	pages = {187--195},
	file = {Albers and Lakens - 2018 - When power analyses based on pilot data are biased.pdf:C\:\\Users\\pskas\\Zotero\\storage\\G8J84SPZ\\Albers and Lakens - 2018 - When power analyses based on pilot data are biased.pdf:application/pdf},
}

