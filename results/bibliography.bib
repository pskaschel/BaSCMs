	file = {PDF:C\:\\Users\\pskas\\Zotero\\storage\\6VPUSEES\\Adamczyk - 2017 - Voluntary and Involuntary Singlehood and Young Adults’ Mental Health an Investigation of Mediating.pdf:application/pdf},
}

