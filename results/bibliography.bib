@article{bentlerTestingModelNesting2010,
	title = {Testing model nesting and equivalence.},
	volume = {15},
	issn = {1939-1463, 1082-989X},
	url = {https://doi.apa.org/doi/10.1037/a0019625},
	doi = {10.1037/a0019625},
	abstract = {When using existing technology, it can be hard or impossible to determine whether two structural equation models that are being considered may be nested. There is also no routine technology for evaluating whether two very different structural models may be equivalent. A simple nesting and equivalence testing (NET) procedure is proposed that uses random sample and model-reproduced moment matrices to evaluate both model nesting and equivalence. The analysis is “local” rather than “global” in nature, but its use with simulation or bootstrapping can imply global conclusions. Two standard applications of NET are to verify whether or not two proposed models are equivalent and whether a baseline model used in an incremental ﬁt index is appropriately nested.},
	language = {en},
	number = {2},
	urldate = {2026-01-21},
