@article{kiritchenko2018,
	title = {Examining {Gender} and {Race} {Bias} in {Two} {Hundred} {Sentiment} {Analysis} {Systems}},
	url = {http://arxiv.org/abs/1805.04508},
	abstract = {Automatic machine learning systems can inadvertently accentuate and perpetuate inappropriate human biases. Past work on examining inappropriate biases has largely focused on just individual systems. Further, there is no benchmark dataset for examining inappropriate biases in systems. Here for the ﬁrst time, we present the Equity Evaluation Corpus (EEC), which consists of 8,640 English sentences carefully chosen to tease out biases towards certain races and genders. We use the dataset to examine 219 automatic sentiment analysis systems that took part in a recent shared task, SemEval-2018 Task 1 ‘Affect in Tweets’. We ﬁnd that several of the systems show statistically signiﬁcant bias; that is, they consistently provide slightly higher sentiment intensity predictions for one race or one gender. We make the EEC freely available.},
	language = {en},
	urldate = {2020-10-22},
