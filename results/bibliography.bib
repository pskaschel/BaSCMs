@article{jonesStableMomentaryPsychosocial2022,
	title = {Stable and momentary psychosocial correlates of everyday smoking: {An} application of {Temporal} {Self}-{Regulation} {Theory}},
	volume = {45},
	issn = {0160-7715, 1573-3521},
