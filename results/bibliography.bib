	pages = {576--588},
	file = {PDF:C\:\\Users\\pskas\\Zotero\\storage\\8N7J2CRM\\Aulbach et al. - 2024 - Why we don't eat as intended Moderators of the short‐term intention–behaviour relation in food inta.pdf:application/pdf},
