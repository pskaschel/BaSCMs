	keywords = {bibliometrics},
	pages = {2215--2222},
	file = {Submitted Version:C\:\\Users\\pskas\\Zotero\\storage\\ZBH7NFI3\\Bornmann and Mutz - 2015 - Growth rates of modern science A bibliometric ana.pdf:application/pdf},
