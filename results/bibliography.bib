@article{silvennoinen2017,
	title = {Semantic distance as a critical factor in icon design for in-car infotainment systems},
	volume = {65},
	issn = {00036870},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0003687017301680},
	doi = {10.1016/j.apergo.2017.07.014},
	abstract = {In-car infotainment systems require icons that enable fluent cognitive information processing and safe interaction while driving. An important issue is how to find an optimised set of icons for different functions in terms of semantic distance. In an optimised icon set, every icon needs to be semantically as close as possible to the function it visually represents and semantically as far as possible from the other functions represented concurrently. In three experiments (N = 21 each), semantic distances of 19 icons to four menu functions were studied with preference rankings, verbal protocols, and the primed product comparisons method. The results show that the primed product comparisons method can be efficiently utilised for finding an optimised set of icons for time-critical applications out of a larger set of icons. The findings indicate the benefits of the novel methodological perspective into the icon design for safety-critical contexts in general.},
	language = {en},
	urldate = {2021-08-06},
	journal = {Applied Ergonomics},
	author = {Silvennoinen, Johanna M. and Kujala, Tuomo and Jokinen, Jussi P.P.},
	month = nov,
	year = {2017},
	pages = {369--381},
	file = {Silvennoinen et al. - 2017 - Semantic distance as a critical factor in icon des.pdf:C\:\\Users\\pskas\\Zotero\\storage\\QPFHIQVE\\Silvennoinen et al. - 2017 - Semantic distance as a critical factor in icon des.pdf:application/pdf;Silvennoinen et al. - 2017 - Semantic distance as a critical factor in icon des.pdf:C\:\\Users\\pskas\\Zotero\\storage\\XQGFR7IV\\Silvennoinen et al. - 2017 - Semantic distance as a critical factor in icon des.pdf:application/pdf},
