@misc{rubenstein2017,
	title = {Causal {Consistency} of {Structural} {Equation} {Models}},
	url = {http://arxiv.org/abs/1707.00819},
	doi = {10.48550/arXiv.1707.00819},
	abstract = {Complex systems can be modelled at various levels of detail. Ideally, causal models of the same system should be consistent with one another in the sense that they agree in their predictions of the eﬀects of interventions. We formalise this notion of consistency in the case of Structural Equation Models (SEMs) by introducing exact transformations between SEMs. This provides a general language to consider, for instance, the diﬀerent levels of description in the following three scenarios: (a) models with large numbers of variables versus models in which the ‘irrelevant’ or unobservable variables have been marginalised out; (b) micro-level models versus macro-level models in which the macrovariables are aggregate features of the microvariables; (c) dynamical time series models versus models of their stationary behaviour. Our analysis stresses the importance of well speciﬁed interventions in the causal modelling process and sheds light on the interpretation of cyclic SEMs.},
	language = {en},
	urldate = {2026-06-04},
	publisher = {arXiv},
	author = {Rubenstein, Paul K. and Weichwald, Sebastian and Bongers, Stephan and Mooij, Joris M. and Janzing, Dominik and Grosse-Wentrup, Moritz and Schölkopf, Bernhard},
	month = jul,
	year = {2017},
	note = {arXiv:1707.00819 [stat.ML]},
	keywords = {Statistics - Methodology, Computer Science - Artificial Intelligence, Computer Science - Machine Learning, Statistics - Machine Learning},
	file = {PDF:C\:\\Users\\pskas\\Zotero\\storage\\S9XD8G23\\Rubenstein et al. - 2017 - Causal Consistency of Structural Equation Models.pdf:application/pdf},
}

