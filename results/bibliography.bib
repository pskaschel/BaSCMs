@article{foley2011,
	title = {Dual-{Task} {Performance} in {Alzheimer}'s {Disease}, {Mild} {Cognitive} {Impairment}, and {Normal} {Ageing}},
	volume = {26},
	issn = {0887-6177},
	url = {https://doi.org/10.1093/arclin/acr032},
	doi = {10.1093/arclin/acr032},
	abstract = {Although several studies have shown that dual-tasking ability is impaired in Alzheimer's disease (AD), the stage at which this deficit manifests remains unclear. This study investigated if a new paper-and-pencil assessment of dual-tasking ability could distinguish between AD, mild cognitive impairment (MCI) and normal ageing in a sample of 50 people with AD, 49 people with MCI, and 50 healthy age-matched controls. The AD group demonstrated a significant impairment in dual-task ability. There was no effect of either MCI or healthy ageing on dual-task performance, indicating that the dual-task impairment is specific to AD.},
	number = {4},
	urldate = {2026-07-23},
	journal = {Archives of Clinical Neuropsychology},
	author = {Foley, Jennifer A. and Kaschel, Reiner and Logie, Robert H. and Della Sala, Sergio},
	month = jun,
	year = {2011},
	pages = {340--348},
