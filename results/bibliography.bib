@article{abhari2015,
	title = {Training for {Planning} {Tumour} {Resection}: {Augmented} {Reality} and {Human} {Factors}},
	volume = {62},
	issn = {0018-9294, 1558-2531},
	shorttitle = {Training for {Planning} {Tumour} {Resection}},
	url = {https://ieeexplore.ieee.org/document/6998039/},
	doi = {10/gdz3kg},
	abstract = {Planning surgical interventions is a complex task, demanding a high degree of perceptual, cognitive, and sensorimotor skills to reduce intra- and post-operative complications. This process requires spatial reasoning to coordinate between the preoperatively acquired medical images and patient reference frames. In the case of neurosurgical interventions, traditional approaches to planning tend to focus on providing a means for visualizing medical images, but rarely support transformation between different spatial reference frames. Thus, surgeons often rely on their previous experience and intuition as their sole guide is to perform mental transformation. In case of junior residents, this may lead to longer operation times or increased chance of error under additional cognitive demands. In this paper, we introduce a mixed augmented-/virtual-reality system to facilitate training for planning a common neurosurgical procedure, brain tumour resection. The proposed system is designed and evaluated with human factors explicitly in mind, alleviating the difﬁculty of mental transformation. Our results indicate that, compared to conventional planning environments, the proposed system greatly improves the nonclinicians’ performance, independent of the sensorimotor tasks performed (p {\textless} 0.01). Furthermore, the use of the proposed system by clinicians resulted in a signiﬁcant reduction in time to perform clinically relevant tasks (p {\textless} 0.05). These results demonstrate the role of mixed-reality systems in assisting residents to develop necessary spatial reasoning skills needed for planning brain tumour resection, improving patient outcomes.},
	language = {en},
	number = {6},
	urldate = {2020-05-04},
	journal = {IEEE Transactions on Biomedical Engineering},
	author = {Abhari, Kamyar and Baxter, John S. H. and Chen, Elvis C. S. and Khan, Ali R. and Peters, Terry M. and de Ribaupierre, Sandrine and Eagleson, Roy},
	month = jun,
	year = {2015},
	keywords = {use},
	pages = {1466--1477},
	file = {Abhari et al. - 2015 - Training for Planning Tumour Resection Augmented .pdf:C\:\\Users\\pskas\\Zotero\\storage\\B8BPHD8K\\Abhari et al. - 2015 - Training for Planning Tumour Resection Augmented .pdf:application/pdf;Abhari et al. - 2015 - Training for Planning Tumour Resection Augmented .pdf:C\:\\Users\\pskas\\Zotero\\storage\\58SJPNXW\\Abhari et al. - 2015 - Training for Planning Tumour Resection Augmented .pdf:application/pdf;Abhari et al. - 2015 - Training for Planning Tumour Resection Augmented .pdf:C\:\\Users\\pskas\\Zotero\\storage\\8NM75235\\Abhari et al. - 2015 - Training for Planning Tumour Resection Augmented .pdf:application/pdf},
