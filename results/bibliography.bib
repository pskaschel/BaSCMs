	pages = {69--85},
	file = {Kościński - 2011 - How do pairs matched in physical attractiveness fo.pdf:C\:\\Users\\pskas\\Zotero\\storage\\UYGF9GDU\\Kościński - 2011 - How do pairs matched in physical attractiveness fo.pdf:application/pdf},
