	keywords = {data reconstruction, impossible values, reporting errors, statistical reporting},
	file = {Heathers et al. - 2018 - Recovering data from summary statistics Sample Pa.pdf:C\:\\Users\\pskas\\Zotero\\storage\\5CTZDDAH\\Heathers et al. - 2018 - Recovering data from summary statistics Sample Pa.pdf:application/pdf},
}

@article{simonton2016,
